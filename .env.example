# Адрес HTTP-сервера
FX_LISTEN_ADDR=:8080

# Строка подключения к PostgreSQL (секрет — не коммитить реальные значения!)
FX_DATABASE_URL=postgres://currency:currency@postgres:5432/currency?sslmode=disable

# Базовый URL внешнего API курсов (формат open.er-api.com).
# По умолчанию в docker-compose используется заглушка mock:8090 —
# под нагрузку сторонний API ставить нельзя (В3), а локальная сеть может
# блокировать open.er-api.com. Реальный провайдер:
# FX_EXCHANGE_API_URL=https://open.er-api.com/v6/latest
FX_EXCHANGE_API_URL=http://mock:8090

# Таймаут запросов к внешнему API, секунды
FX_HTTP_TIMEOUT=5

# TTL кэша курсов, секунды
FX_RATES_TTL=3600

# Уровень логирования: debug|info|warn|error
FX_LOG_LEVEL=info
